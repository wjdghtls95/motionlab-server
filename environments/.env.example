# Application
NODE_ENV=local
PORT=3000
CORS_ORIGIN=http://localhost:4000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password_here
DB_DATABASE=motionlab
DB_SYNCHRONIZE=true
DB_LOGGING=true

# Database URLs
MYSQL_URL=mysql://root:your_password_here@localhost:3306/motionlab
MONGO_URL=mongodb://localhost:27017/motionlab

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Storage
STORAGE_TYPE=local
UPLOAD_DIR=./uploads/motions

# S3 (로컬에서는 사용 안 함, 정의만)
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Analyzer
ANALYZER_URL=http://localhost:8000
INTERNAL_API_KEY=change_this_in_production

# JWT
JWT_SECRET=change_this_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d