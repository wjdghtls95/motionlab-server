# Application
NODE_ENV=local
PORT=3000
CORS_ORIGIN=http://localhost:4000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password_here
DB_DATABASE=motionlab
DB_SYNCHRONIZE=true  # 로컬 개발 전용. 프로덕션에서는 false 또는 미설정 (database.config.ts에서 강제 차단)
DB_LOGGING=true

# Database URLs
MYSQL_URL=mysql://root:your_password_here@localhost:3306/motionlab
MONGO_URL=mongodb://localhost:27017/motionlab

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Storage
STORAGE_TYPE=local
UPLOAD_DIR=./uploads/motions

# S3 (로컬에서는 사용 안 함, 정의만)
R2_BUCKET_NAME=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Analyzer
ANALYZER_URL=http://localhost:8000
INTERNAL_API_KEY=change_this_in_production

# JWT
JWT_SECRET=change_this_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Admin Seeder (초기 어드민 계정 자동 생성, 없으면 건너뜀)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Sentry
SENTRY_DSN=