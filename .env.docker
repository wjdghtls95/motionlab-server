# ===========================================
# MotionLab System Environment Variables
# ===========================================

# ----------------
# Node Environment
# ----------------
NODE_ENV=development

# ----------------
# API Server (NestJS)
# ----------------
API_PORT=4000

# ----------------
# Database (MySQL)
# ----------------
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root123
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=motionlab
DB_PASSWORD=motionlab123
DB_DATABASE=motionlab

# ----------------
# Redis
# ----------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ----------------
# JWT Authentication
# ----------------
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# ----------------
# Analyzer (FastAPI)
# ----------------
ANALYZER_PORT=8000
ANALYZER_URL=http://analyzer:8000
ANALYZER_API_KEY=dev-internal-key-123

ENV=dev
DEBUG_MODE=true
LLM_PROVIDER=noop
OPENAI_API_KEY=

# ----------------
# AWS (Optional)
# ----------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-northeast-2
# S3_BUCKET=motionlab-videos
